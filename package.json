{
  "name": "arknights-infra-calc-beta-test",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 5174",
    "dev:full": "npm run dev",
    "build": "next build",
    "test:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "test:build-traces": "node scripts/check-build-traces.mjs",
    "test:production-client": "node scripts/check-production-client.mjs",
    "start": "next start -H 0.0.0.0 -p 5174",
    "test": "node --test --experimental-strip-types scripts/arkntools-assets.test.mjs scripts/build-tooling.test.mjs src/operbox.test.ts src/deployment.test.ts src/operator-portraits.test.ts src/building-rooms.test.ts src/fiammetta-settings.test.ts src/setup-configuration.test.ts src/plan-history.test.ts src/room-visuals.test.ts src/server/shift-parser.test.ts src/server/plan-protocol.test.ts src/server/infra-private-records.test.ts src/server/skland/device-id-cache.test.ts src/server/skland/normalize.test.ts src/server/skland/session.test.ts src/skland-auth-url.test.ts src/layout-validation.test.ts src/operbox-normalization.test.ts src/schedule-autofill.test.ts src/schedule-list-layout.test.ts src/schedule-view-presentation.test.ts src/skland-status-metrics.test.ts src/rotation-settings.test.ts src/rotation-result.test.ts src/rotation-presentation.test.ts src/persistence.test.ts",
    "test:api-contract": "node --test --experimental-strip-types src/server/api-contract.test.ts src/server/public-plan.test.ts",
    "test:shift-comparison": "node --test --experimental-strip-types src/skland.test.ts",
    "test:deploy": "bash scripts/prepare-release.test.sh && bash scripts/deploy-release.test.sh",
    "test:solver-contract": "node scripts/solver-contract-smoke.mjs",
    "audit:security": "npm audit --audit-level=high",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:production-profile": "playwright test --config=playwright.production.config.ts --project=chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "assets:room-emblems": "node scripts/extract-room-emblems.mjs",
    "assets:sync:arkntools": "node scripts/sync-arkntools-assets.mjs",
    "assets:check": "node scripts/sync-arkntools-assets.mjs --check",
    "lint": "eslint .",
    "check": "npm run assets:check && npm run lint && npm test && npm run test:api-contract && npm run test:shift-comparison"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "calligraph": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "motion": "^13.0.0",
    "next": "16.3.0",
    "overlayscrollbars": "^2.16.0",
    "qrcode.react": "4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.0",
    "skland-kit": "0.3.5",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "^0.2.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  }
}
